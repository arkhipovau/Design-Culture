          <p class="article-meta">Франция • Париж • Продукт</p>
        </div>
        <figure class="interview-portrait">
          <img src="../../images/%D0%93%D0%B0%D0%B2%D1%80%D0%B8%D0%BB%20%D0%9F%D0%B5%D1%80%D0%BE%D0%B2.jpg" alt="Гаврил Перов" width="200" height="267" loading="lazy" decoding="async" />
